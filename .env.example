# ===========================================
# Kova environment variables
# Copy to .env.local for local development and fill in the values.
# Keep values unquoted: scripts/seed.js reads .env.local with a minimal parser.
# In production, set them in your host's environment instead.
# ===========================================

# --- App ---
# Public origin of the app. Used for canonical URLs, the sitemap, Socket.IO
# CORS in production and Stripe return links. NEXT_PUBLIC_* values are inlined
# into the browser bundle at build time, so set this before `npm run build`.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- MongoDB (required) ---
# Local: `npm run db:up` starts one with docker compose. Include the database name.
MONGODB_URI=mongodb://localhost:27017/kova
# Hosted example: mongodb+srv://<username>:<password>@<cluster-host>/<dbname>?retryWrites=true&w=majority

# --- Redis (required) ---
# Holds the H3 driver index, dispatch locks, ride-room membership and the
# contact-form rate limit. Nothing in it needs to survive a restart.
REDIS_URL=redis://localhost:6379

# --- Auth (required) ---
# Signs NextAuth sessions AND the short-lived Socket.IO tokens.
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=generate_a_long_random_secret_here
# Optional: the app trusts the request host, so this is only needed behind
# proxies that rewrite the Host header.
NEXTAUTH_URL=http://localhost:3000

# --- Drivers ---
# New drivers are approved instantly unless this is "false". Set "false" in
# production so an admin approves each driver under /admin/drivers.
DRIVER_AUTO_APPROVE=true

# --- Realtime (optional) ---
# Socket.IO is served by the same process and origin; only set this if you
# run the socket server on a different origin.
NEXT_PUBLIC_SOCKET_URL=

# --- Free geo services (optional overrides) ---
# Defaults are the public OSRM and Photon instances, which have no SLA.
# Point these at your own instances for real traffic.
OSRM_URL=
PHOTON_URL=

# --- Stripe (optional) ---
# Enables card top-ups for the rider wallet and driver payouts (Stripe Connect
# Express). With STRIPE_SECRET_KEY unset the wallet falls back to instant demo
# credits, which is only safe for demos.
# Webhook: <your origin>/api/webhooks/stripe with the events
# `checkout.session.completed` and `account.updated`.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Object storage (optional) ---
# Any S3-compatible bucket. Only the presigned-upload endpoint
# (/api/upload/presigned) uses it; it answers 503 until all four of bucket,
# keys and endpoint are set. Profile pictures are stored in MongoDB and need
# none of this.
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_ENDPOINT=https://s3.your-provider.example
# Public base URL for uploaded objects (a CDN or the bucket's public domain).
STORAGE_PUBLIC_URL=
# Some providers need a real region name; "auto" works for most others.
STORAGE_REGION=auto

# --- Server (optional) ---
# PORT=3000
# BIND_HOST=0.0.0.0
